{
  "name": "restaurentreactnativelatest",
  "main": "index.js",
  "version": "1.0.2",
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@expo/vector-icons": "^15.1.1",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^22.3.0",
    "@react-native-firebase/messaging": "^22.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "electron:dev": "electron electron/main.js",
    "build:web": "expo export --platform web",
    "build:exe": "expo export --platform web && node -e \"const fs = require('fs'); fs.cpSync('dist', 'electron/dist', { recursive: true });\" && electron-builder --win --project electron"
  },
  "build": {
    "appId": "com.leevon.restaurantpartner",
    "productName": "Leevon Restaurant Partner",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "private": true
}
