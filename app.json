{
  "expo": {
    "name": "Leevon Delivery Restaurent Partner",
    "slug": "restaurentreactnativelatest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/leevon-logo-padded.png",
    "scheme": "restaurentreactnativelatest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/leevon-logo-padded.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/leevon-logo-padded.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.restaurent.app",
      "googleServicesFile": "./google-services.json"
    },
    "notification": {
      "icon": "./assets/images/android-icon-monochrome.png",
      "color": "#000000"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withAndroidNotificationManifest.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
